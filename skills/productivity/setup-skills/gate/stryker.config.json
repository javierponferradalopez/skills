{
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "related": false },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": ".agents/gate/last-run/mutation.json" },
  "tempDirName": ".agents/gate/.stryker-tmp",
  "ignorePatterns": [".agents"],
  "thresholds": { "break": 100 },
  "concurrency": 4
}
